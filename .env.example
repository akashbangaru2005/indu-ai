# Set these in your shell; this file is a reference and is not auto-loaded.
INDU_DEPLOYMENT_MODE=local
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
INDU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
WHATSAPP_COUNTRY_CODE=91
# Optional local contacts/outbox database override (used by isolated tests).
# INDU_DATABASE=
# Optional per-user data directory (default: LOCALAPPDATA/InduAI on Windows).
# INDU_DATA_DIR=
# Render: use INDU_DEPLOYMENT_MODE=cloud and backend/requirements-render.txt.
# INDU_ALLOWED_HOSTS=api.example.com
